rules_version = '2';

// Règles Firestore de Prepalog.
// Principe : un élève n'accède qu'à ses propres données ; un enseignant n'accède qu'aux
// groupes où son uid figure dans `profs` ; le rôle n'est jamais modifiable par son porteur.
//
// Deux disciplines, apprises à la mise en service du 30/09/2026 :
//  1. Aucune règle ne doit supposer qu'un document existe. Un `get()` sur un document
//     absent rend null, et lire un champ de null fait échouer TOUTE l'évaluation : le
//     refus qui en résulte est indistinct d'un vrai refus de droits. D'où `monProfil()`,
//     qui rend une map vide plutôt que null, et l'usage systématique de `.get(clé, défaut)`.
//  2. Une règle qui sert à une requête (`list`) s'appuie sur `resource.data`, jamais sur un
//     `get()` du document listé : le document est déjà en main, et un `get()` par document
//     renvoyé serait une lecture facturée de plus.

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte()      { return request.auth != null; }
    function moi()           { return request.auth.uid; }

    // Profil de l'utilisateur connecté, ou map vide s'il n'en a pas encore.
    function monProfil() {
      return exists(/databases/$(database)/documents/users/$(moi()))
        ? get(/databases/$(database)/documents/users/$(moi())).data
        : {};
    }
    function monRole()       { return monProfil().get('role', ''); }
    function mesGroupes()    { return monProfil().get('groupes', []); }
    function estProf()       { return connecte() && monRole() == 'prof'; }
    function membreDuGroupe(gid) { return connecte() && gid in mesGroupes(); }

    // Un nombre raisonnable (audit du 15/10/2026) : ni négatif, ni au-delà de `haut`. Sert à borner
    // ce qu'un élève écrit dans ses propres résultats. L'appelant passe `.get(clé, 0)` pour ne
    // jamais supposer que le champ existe (un champ absent vaut 0, donc passe).
    function nombreBorne(x, haut) { return x is number && x >= 0 && x <= haut; }

    // Réservé aux lectures et écritures unitaires : fait un get() du groupe visé.
    function profDuGroupe(gid) {
      return connecte()
        && exists(/databases/$(database)/documents/groupes/$(gid))
        && moi() in get(/databases/$(database)/documents/groupes/$(gid)).data.get('profs', []);
    }

    // « Responsable » d'un groupe = le premier de sa liste `profs` (le créateur ; un collègue ajouté
    // se place à la fin). Chantier 11, lot 11b (09/10/2026). Jamais d'hypothèse sur le groupe :
    // `exists()` d'abord (un `get()` sur un document absent rend null), `.get('profs', [])` ensuite
    // (champ absent), et `[0]` seulement sur une liste non vide (un `[0]` sur une liste vide fait
    // échouer l'évaluation, donc refuse : acceptable ici, mais on ne s'y fie pas).
    function responsableDe(gid) {
      return exists(/databases/$(database)/documents/groupes/$(gid))
        && get(/databases/$(database)/documents/groupes/$(gid)).data.get('profs', []).size() > 0
        && get(/databases/$(database)/documents/groupes/$(gid)).data.get('profs', [])[0] == moi();
    }
    // Le profil d'un élève cite ses groupes ; le premier est celui où il travaille (core/app.js).
    function responsableDuPremierGroupe(gs) {
      return gs is list && gs.size() > 0 && gs[0] is string && responsableDe(gs[0]);
    }

    // ---------------------------------------------------------------- profils
    match /users/{uid} {
      // Chacun lit son profil ; un enseignant lit les profils de ses élèves.
      allow read: if connecte() && (uid == moi() || estProf());

      // Création : par un enseignant seulement, et seulement d'un compte élève.
      //
      // Cette règle portait jusqu'au 30/09/2026 une seconde branche,
      // `uid == moi() && request.resource.data.role == 'prof'`, censée servir à l'amorçage.
      // Elle n'en était pas une : elle autorisait n'importe quel compte authentifié à se
      // créer un profil enseignant. L'authentification Google accepte tout compte Google et
      // `prepalog-config.json` est public, donc n'importe qui pouvait devenir enseignant,
      // puis lire tous les profils — noms, matricules et codes des élèves — et manipuler
      // les groupes. Aucune autre règle ne rattrapait le coup : `estProf()` se contente de
      // relire ce profil-là.
      //
      // Elle est supprimée sans remplacement. L'amorçage d'un enseignant se fait à la main
      // dans la console Firebase (procédure dans claude/prepalog-firebase.md), ce qui était
      // déjà le cas : la branche ne servait donc à rien qu'à ouvrir la porte.
      allow create: if request.resource.data.role == 'eleve' && estProf();

      // Mise à jour.
      //
      // L'élève ne modifie RIEN de son profil, nom et prénom compris (audit du 15/10/2026).
      // Le 08/10/2026 (C1) il ne pouvait déjà changer que `nom` et `prenom` (liste blanche : plus
      // de groupe ajouté, ni de `matricule`, `code`, `role` ou aménagement touché). Reste que ces
      // deux champs sont ceux qu'affichent le suivi de classe et les exports : depuis la console du
      // navigateur, un élève pouvait prendre le nom d'un camarade. Or aucun écran élève n'écrit
      // dans son profil (vérifié : toutes les écritures de `users` dans core/ sont celles d'un
      // enseignant) ; cette branche ne servait donc à rien d'autre. Fermée sans remplacement : si un
      // écran « changer mon prénom » voit le jour, il faudra une règle écrite pour lui.
      //
      // L'enseignant met à jour le profil d'un ÉLÈVE (groupes, aménagements, nom), jamais
      // celui d'un collègue, et ne change jamais un rôle. Le sien reste modifiable.
      allow update: if connecte() && request.resource.data.role == resource.data.role
        && estProf() && (uid == moi() || resource.data.get('role', '') == 'eleve');

      // Suppression : l'enseignant efface un profil d'élève (supprimerEleve), jamais celui
      // d'un collègue. Chantier 11, lot 11b (09/10/2026) : on ne supprime que ce qu'on a créé, ou
      // ce dont on est responsable. Un profil d'élève peut donc être supprimé par
      //  - son auteur (`creePar` == moi) ;
      //  - n'importe quel enseignant s'il n'a pas d'auteur (élève créé à la console, ou avant le
      //    champ `creePar`) : c'est le comportement d'avant, qu'on ne retire à personne ;
      //  - le responsable du premier groupe de l'élève (il efface ce que son co-enseignant a créé).
      // Jamais par un simple co-enseignant, ni par un enseignant étranger : celui-là DÉTACHE
      // l'élève de son groupe (`groupes` : mise à jour permise plus haut), ce qui est réversible.
      // `get('creePar', '')` : le champ n'est jamais supposé exister.
      allow delete: if estProf() && resource.data.get('role', '') == 'eleve' && (
        resource.data.get('creePar', '') in ['', null, moi()]
        || responsableDuPremierGroupe(resource.data.get('groupes', []))
      );
    }

    // ---------------------------------------------------------------- groupes
    match /groupes/{gid} {
      // Lecture unitaire ET requête : tout passe par `resource.data`, donc sans lecture
      // supplémentaire. La requête de l'enseignant filtre sur `profs array-contains`, donc
      // chaque document renvoyé satisfait la première branche par construction.
      // `resource == null` : lecture d'un groupe inexistant. L'application s'en sert pour
      // refuser un nom déjà pris avant de créer. Seule l'existence est divulguée, à un
      // utilisateur déjà authentifié — et sans ce cas, aucun groupe ne peut être créé.
      allow read:   if connecte() && (
        resource == null
        || moi() in resource.data.get('profs', [])
        || gid in mesGroupes()
      );
      allow create: if estProf() && moi() in request.resource.data.get('profs', []);
      allow update: if profDuGroupe(gid);
      // Suppression réservée au responsable (premier de `profs`) : un co-enseignant QUITTE le groupe
      // (il se retire de `profs`, ce que `update` permet), il ne le supprime pas (chantier 11, lot 11b).
      // `resource` est déjà en main : aucune lecture de plus. Absent ou sans `profs` = refus.
      allow delete: if connecte() && resource != null
        && resource.data.get('profs', []).size() > 0
        && resource.data.get('profs', [])[0] == moi();
    }

    // ---------------------------------------------------------------- travaux
    match /travaux/{gid}/eleves/{uid}/activites/{aid} {
      allow read:  if uid == moi() || profDuGroupe(gid);
      // Un élève n'écrit que ses propres résultats, et seulement dans un groupe
      // dont il est membre.
      // Copie rendue (évaluation, 02/10/2026) : un résultat qui porte `rendu` est FIGÉ pour
      // l'élève — il ne peut ni le réécrire ni l'effacer. Seul l'enseignant du groupe le
      // modifie (ramasser, rouvrir). `resource == null` : création, toujours permise.
      //
      // Audit du 08/10/2026 (C1) : l'élève ne pose pas la marque `parProf` d'une note d'enseignant, ne touche pas
      // à un document que l'enseignant a noté, n'écrit pas les drapeaux `_debloque-*`
      // (déblocage de parcours, réservé à l'enseignant) et ne met pas un autre uid/gid
      // dans le document. Le score lui-même reste calculé par le navigateur : l'outil est
      // formatif, une évaluation notée se passe en classe.
      //
      // Audit du 15/10/2026 : on ne l'empêche pas, on refuse seulement l'absurde, ce que la console du
      // navigateur permet d'écrire à la main. `score`, `max` et `meilleur` : un nombre entre 0 et 1000
      // (un barème réel est de 20, le plafond est large exprès). `tentatives` : un nombre positif.
      // On n'exige PAS `meilleur <= max` ni `score <= max` : `meilleurScore` (core/notes.js) convertit
      // l'ancien meilleur quand le barème d'une séance change, et le bonus du niveau confirmé peut
      // dépasser le barème ; une écriture refusée en classe vaut un « score non enregistré » devant
      // les élèves, ce qui est pire que la faille. `ramasse` : « ramassée » veut dire que l'enseignant a
      // ramassé la copie (core/copie.js), l'élève ne l'écrit jamais à vrai. `max`, `meilleur`,
      // `tentatives` passent par `.get(clé, 0)` : jamais d'hypothèse qu'ils existent. Les enseignants du
      // groupe ne sont pas concernés par ces bornes (la branche `profDuGroupe` est à part).
      allow create, update: if (uid == moi() && membreDuGroupe(gid)
                                && !aid.matches('_debloque-.*')
                                && (resource == null
                                    || (!('rendu' in resource.data) && resource.data.get('parProf', false) != true))
                                && !('parProf' in request.resource.data)
                                && request.resource.data.get('uid', uid) == uid
                                && request.resource.data.get('gid', gid) == gid
                                && nombreBorne(request.resource.data.get('score', 0), 1000)
                                && nombreBorne(request.resource.data.get('max', 0), 1000)
                                && nombreBorne(request.resource.data.get('meilleur', 0), 1000)
                                && request.resource.data.get('tentatives', 0) is number
                                && request.resource.data.get('tentatives', 0) >= 0
                                && request.resource.data.get('ramasse', false) != true)
                            || profDuGroupe(gid);
      // Suppression (décision de Tristan, 08/10/2026) : la remise à neuf d'un parcours
      // (`versionBase`, core/app.js) est faite par l'élève lui-même : il efface ses scores du
      // parcours et les déblocages de séance. Il peut donc supprimer ses propres travaux, SAUF
      // une copie rendue et une note posée par l'enseignant (`parProf`), qui restent figées, et
      // les drapeaux `_reprise-*`. Le drapeau `_debloque-*` est posé par l'enseignant (donc
      // marqué `parProf`) mais l'élève peut le retirer : il ne peut toujours pas le créer
      // (voir `allow create, update` ci-dessus). Supprimer un document absent est permis.
      allow delete: if (uid == moi() && membreDuGroupe(gid)
                        && !aid.matches('_reprise-.*')
                        && (resource == null
                            || (!('rendu' in resource.data)
                                && (aid.matches('_debloque-.*') || resource.data.get('parProf', false) != true))))
                    || profDuGroupe(gid);
    }

    // ------------------------------------------------- jeux privés (portée élève)
    match /prives/{uid}/jeux/{aid} {
      allow read:  if uid == moi() || estProf();
      // Audit du 15/10/2026 : le compte doit avoir un profil. Un compte Firebase créé à la volée sans
      // profil (l'inscription est ouverte : c'est ainsi que les élèves sont créés, depuis l'application)
      // n'a plus d'endroit où écrire dans notre base. Coût : une lecture de règle par écriture privée
      // (le `exists()` du profil), mise en cache pour la durée de la requête. La suppression reste
      // permise à son propriétaire sans cette condition (voir plus bas).
      allow write: if uid == moi() && exists(/databases/$(database)/documents/users/$(moi()));
      // Purge : l'enseignant efface le travail d'un élève qu'il supprime, sans pouvoir le
      // modifier. Écrire à sa place reste interdit — seul l'effacement est ouvert.
      allow delete: if uid == moi() || estProf();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
