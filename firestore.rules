rules_version = '2';

// Règles Firestore de Prepalog.
// Principe : un élève n'accède qu'à ses propres données ; un enseignant n'accède qu'aux
// groupes où son uid figure dans `profs` ; le rôle n'est jamais modifiable par son porteur.
//
// Deux disciplines, apprises à la mise en service du 30/09/2026 :
//  1. Aucune règle ne doit supposer qu'un document existe. Un `get()` sur un document
//     absent rend null, et lire un champ de null fait échouer TOUTE l'évaluation : le
//     refus qui en résulte est indistinct d'un vrai refus de droits. D'où `monProfil()`,
//     qui rend une map vide plutôt que null, et l'usage systématique de `.get(clé, défaut)`.
//  2. Une règle qui sert à une requête (`list`) s'appuie sur `resource.data`, jamais sur un
//     `get()` du document listé : le document est déjà en main, et un `get()` par document
//     renvoyé serait une lecture facturée de plus.

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte()      { return request.auth != null; }
    function moi()           { return request.auth.uid; }

    // Profil de l'utilisateur connecté, ou map vide s'il n'en a pas encore.
    function monProfil() {
      return exists(/databases/$(database)/documents/users/$(moi()))
        ? get(/databases/$(database)/documents/users/$(moi())).data
        : {};
    }
    function monRole()       { return monProfil().get('role', ''); }
    function mesGroupes()    { return monProfil().get('groupes', []); }
    function estProf()       { return connecte() && monRole() == 'prof'; }
    function membreDuGroupe(gid) { return connecte() && gid in mesGroupes(); }

    // Réservé aux lectures et écritures unitaires : fait un get() du groupe visé.
    function profDuGroupe(gid) {
      return connecte()
        && exists(/databases/$(database)/documents/groupes/$(gid))
        && moi() in get(/databases/$(database)/documents/groupes/$(gid)).data.get('profs', []);
    }

    // ---------------------------------------------------------------- profils
    match /users/{uid} {
      // Chacun lit son profil ; un enseignant lit les profils de ses élèves.
      allow read: if connecte() && (uid == moi() || estProf());

      // Création : par un enseignant seulement (comptes élèves créés en lot).
      // Le tout premier enseignant est amorcé à la main dans la console, `superAdmins`
      // étant laissé vide dans prepalog-config.json.
      allow create: if connecte() && (
        (request.resource.data.role == 'eleve' && estProf()) ||
        (uid == moi() && request.resource.data.role == 'prof')
      );

      // Mise à jour : l'intéressé ne peut jamais changer son propre rôle.
      allow update: if connecte() && (
        (uid == moi() && request.resource.data.role == resource.data.role) ||
        (estProf() && request.resource.data.role == resource.data.role)
      );

      allow delete: if estProf();
    }

    // ---------------------------------------------------------------- groupes
    match /groupes/{gid} {
      // Lecture unitaire ET requête : tout passe par `resource.data`, donc sans lecture
      // supplémentaire. La requête de l'enseignant filtre sur `profs array-contains`, donc
      // chaque document renvoyé satisfait la première branche par construction.
      // `resource == null` : lecture d'un groupe inexistant. L'application s'en sert pour
      // refuser un nom déjà pris avant de créer. Seule l'existence est divulguée, à un
      // utilisateur déjà authentifié — et sans ce cas, aucun groupe ne peut être créé.
      allow read:   if connecte() && (
        resource == null
        || moi() in resource.data.get('profs', [])
        || gid in mesGroupes()
      );
      allow create: if estProf() && moi() in request.resource.data.get('profs', []);
      allow update: if profDuGroupe(gid);
      allow delete: if profDuGroupe(gid);
    }

    // ---------------------------------------------------------------- travaux
    match /travaux/{gid}/eleves/{uid}/activites/{aid} {
      allow read:  if uid == moi() || profDuGroupe(gid);
      // Un élève n'écrit que ses propres résultats, et seulement dans un groupe
      // dont il est membre.
      allow write: if (uid == moi() && membreDuGroupe(gid)) || profDuGroupe(gid);
    }

    // ------------------------------------------------- jeux privés (portée élève)
    match /prives/{uid}/jeux/{aid} {
      allow read:  if uid == moi() || estProf();
      allow write: if uid == moi();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
